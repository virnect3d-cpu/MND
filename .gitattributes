# 텍스트는 체크아웃 시 OS 줄바꿈으로, 저장소엔 LF 로 정규화
* text=auto
# Unity YAML — 병합 도구가 붙어 있으면 씬/프리팹 3-way 머지에 씀
*.unity      merge=unityyamlmerge eol=lf
*.prefab     merge=unityyamlmerge eol=lf
*.asset      merge=unityyamlmerge eol=lf
*.mat        merge=unityyamlmerge eol=lf
*.meta       merge=unityyamlmerge eol=lf
*.controller merge=unityyamlmerge eol=lf
*.anim       merge=unityyamlmerge eol=lf
# 바이너리 (줄바꿈 변환 금지)
*.fbx  binary
*.obj  binary
*.blend binary
*.hdr  binary
*.exr  binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.tga  binary
*.psd  binary
*.wlt  binary
*.dll  binary
*.so   binary
*.a    binary
*.wav  binary
*.mp3  binary
*.mp4  binary

# ---- Git LFS ----
# yeouido63 의 바이너리 에셋. FBX/텍스처/HDRI 는 델타 압축이 안 되므로
# 한 번 수정할 때마다 전체 용량이 히스토리에 통째로 쌓인다.
# (예: 63_BILLD_ALL.fbx 70MB -> LFS 포인터 133 bytes)
# 주의: 아래 규칙은 이 커밋 이후 버전에만 적용된다. 이전 커밋에 들어간
# blob 은 그대로 남으므로, 저장소 용량을 소급해서 줄이려면
# `git lfs migrate import` 로 히스토리를 재작성해야 한다.
unity/DRON/Assets/yeouido63/**/*.fbx filter=lfs diff=lfs merge=lfs -text
unity/DRON/Assets/yeouido63/**/*.hdr filter=lfs diff=lfs merge=lfs -text
unity/DRON/Assets/yeouido63/**/*.exr filter=lfs diff=lfs merge=lfs -text
unity/DRON/Assets/yeouido63/**/*.png filter=lfs diff=lfs merge=lfs -text
unity/DRON/Assets/yeouido63/**/*.jpg filter=lfs diff=lfs merge=lfs -text
unity/DRON/Assets/yeouido63/**/*.tga filter=lfs diff=lfs merge=lfs -text
unity/DRON/Assets/yeouido63/**/*.psd filter=lfs diff=lfs merge=lfs -text
